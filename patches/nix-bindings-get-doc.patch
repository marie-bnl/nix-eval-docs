@@ -592,6 +592,32 @@ impl<'a> Value<'a> {
       ValueType::External => Ok("<external>".to_string()),
     }
   }
+
+  pub fn get_doc(&self) -> Result<String> {
+    // TODO: CHECK SAFETY
+
+    let doc_ptr = unsafe {
+      sys::nix_get_value_doc(
+        self.state.context.as_ptr(),
+        self.state.as_ptr(),
+        self.inner.as_ptr(),
+      )
+    };
+
+    if doc_ptr.is_null() {
+      return Err(Error::NullPointer);
+    }
+
+    let doc_content_ptr = unsafe {
+      sys::nix_get_doc_content(doc_ptr)
+    };
+
+    let doc_content = unsafe { CStr::from_ptr(doc_content_ptr) }
+      .to_string_lossy()
+      .into_owned();
+
+    Ok(doc_content)
+  }
 }
 
