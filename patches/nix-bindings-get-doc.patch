diff --git a/nix-bindings/src/doc.rs b/nix-bindings/src/doc.rs
new file mode 100644
index 0000000..75c1ac0
--- /dev/null
+++ b/nix-bindings/src/doc.rs
@@ -0,0 +1,64 @@
+// TODO: ADD SAFETY CHECKS
+
+use std::{ffi::CStr, ptr::NonNull};
+
+use crate::{
+  Error,
+  Pos,
+  Result,
+  sys,
+};
+
+pub struct Doc {
+  pub(crate) inner: NonNull<sys::nix_doc>,
+}
+
+impl Doc {
+  pub fn get_pos(&self) -> Result<Pos> {
+    let pos_ptr = unsafe {
+      sys::nix_get_doc_pos(self.inner.as_ptr())
+    };
+
+    let inner = NonNull::new(pos_ptr).ok_or(Error::NullPointer)?;
+
+    Ok(Pos { inner })
+  }
+
+  pub fn get_name(&self) -> Result<String> {
+    let name_ptr = unsafe { sys::nix_get_doc_name(self.inner.as_ptr()) };
+
+    if name_ptr.is_null() {
+      return Err(Error::NullPointer);
+    }
+
+    let name = unsafe { CStr::from_ptr(name_ptr) }
+      .to_string_lossy()
+      .into_owned();
+
+    Ok(name)
+  }
+
+  pub fn get_args(&self) -> Result<Vec<String>> {
+    let args_size = unsafe { sys::nix_get_doc_args_size(self.inner.as_ptr()) };
+
+    let args: Vec<String> = (0..args_size).map(|i|
+      unsafe { CStr::from_ptr(
+        sys::nix_get_doc_arg_by_idx(self.inner.as_ptr(), i)
+      ) }
+        .to_string_lossy()
+        .into_owned()
+    ).collect();
+
+    Ok(args)
+  }
+
+  pub fn get_content(&self) -> Result<String> {
+    let content_ptr = unsafe { sys::nix_get_doc_content(self.inner.as_ptr()) };
+
+    let content = unsafe { CStr::from_ptr(content_ptr) }
+      .to_string_lossy()
+      .into_owned();
+
+    Ok(content)
+  }
+}
