@@ -6,6 +6,7 @@
 use std::{ffi::CStr, fmt, ptr::NonNull, sync::Arc};
 
 use crate::{
+  Doc,
   Error,
   EvalState,
   Result,
@@ -592,6 +593,27 @@ impl<'a> Value<'a> {
       ValueType::External => Ok("<external>".to_string()),
     }
   }
+
+  pub fn get_doc(&self) -> Result<Doc> {
+    if self.value_type() != ValueType::Function {
+      return Err(Error::InvalidType {
+        expected: "function",
+        actual:   self.value_type().to_string(),
+      });
+    }
+
+    let doc_ptr = unsafe {
+      sys::nix_get_value_doc(
+        self.state.context.as_ptr(),
+        self.state.as_ptr(),
+        self.inner.as_ptr(),
+      )
+    };
+
+    let inner = NonNull::new(doc_ptr).ok_or(Error::NullPointer)?;
+
+    Ok(Doc { inner })
+  }
 }
 
