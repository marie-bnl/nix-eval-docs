diff --git a/nix-bindings/src/value.rs b/nix-bindings/src/value.rs
index 80c9fd2..3ec6eff 100644
--- a/nix-bindings/src/value.rs
+++ b/nix-bindings/src/value.rs
@@ -592,6 +592,60 @@ impl<'a> Value<'a> {
       ValueType::External => Ok("<external>".to_string()),
     }
   }
+
+  fn get_doc_ptr(&self) -> Result<*mut sys::nix_doc> {
+    let doc_ptr = unsafe {
+      sys::nix_get_value_doc(
+        self.state.context.as_ptr(),
+        self.state.as_ptr(),
+        self.inner.as_ptr(),
+      )
+    };
+
+    if doc_ptr.is_null() {
+      return Err(Error::NullPointer);
+    }
+
+    Ok(doc_ptr)
+  }
+
+  pub fn get_doc_name(&self) -> Result<String> {
+    let name_ptr = unsafe { sys::nix_get_doc_name(self.get_doc_ptr()?) };
+
+    if name_ptr.is_null() {
+      return Err(Error::NullPointer);
+    }
+
+    let name = unsafe { CStr::from_ptr(name_ptr) }
+      .to_string_lossy()
+      .into_owned();
+
+    Ok(name)
+  }
+
+  pub fn get_doc_args(&self) -> Result<Vec<String>> {
+    let doc_ptr = self.get_doc_ptr()?;
+
+    let args_size = unsafe { sys::nix_get_doc_args_size(doc_ptr) };
+
+    let args: Vec<String> = (0..args_size).map(|i|
+      unsafe { CStr::from_ptr(sys::nix_get_doc_arg_by_idx(doc_ptr, i)) }
+        .to_string_lossy()
+        .into_owned()
+    ).collect();
+
+    Ok(args)
+  }
+
+  pub fn get_doc_content(&self) -> Result<String> {
+    let content_ptr = unsafe { sys::nix_get_doc_content(self.get_doc_ptr()?) };
+
+    let content = unsafe { CStr::from_ptr(content_ptr) }
+      .to_string_lossy()
+      .into_owned();
+
+    Ok(content)
+  }
 }
 
 impl Drop for Value<'_> {
