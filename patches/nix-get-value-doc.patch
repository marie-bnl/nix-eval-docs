     return &s->storePaths[i];
 }
 
+const char * nix_get_value_doc(nix_c_context * context, EvalState * state, nix_value * value)
+{
+    if (context)
+        context->last_err_code = NIX_OK;
+    try {
+        auto & v = check_value_in(value);
+        assert(v.type() == nix::nFunction); // TODO: Also check if it's a PrimOps or a Functor
+        auto doc = state->state.getDoc(v);
+        if (doc) return *doc; else return ""; // TODO: There surely is a better solution than return ""
+    }
+    NIXC_CATCH_ERRS_NULL
+}
+
 } // extern "C"
